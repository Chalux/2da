; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false
warnings/check_angle_interpolation_type_conflicting=false

[application]

config/name="plat adv demo"
config/version="0.1.1"
run/main_scene="res://Scenes/RootScene.tscn"
config/features=PackedStringArray("4.4", "C#", "Mobile")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

SkillManager="*res://Objects/SkillManager.tscn"
GameGlobal="*res://Objects/GameGlobal.tscn"
SoundManager="*res://Objects/SoundManager.tscn"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
DialogicCSharp="*res://addons/dialogic/Dialogic.cs"

[dialogic]

directories/dch_directory={
"Owens": "res://Dialogic/Characters/Owens.dch",
"SlimeNpc": "res://Dialogic/Characters/SlimeNpc.dch"
}
directories/dtl_directory={
"BeginSlime1": "res://Dialogic/TimeLines/BeginSlime1.dtl",
"HomeDream1": "res://Dialogic/TimeLines/HomeDream1.dtl",
"HomeMineSP1": "res://Dialogic/TimeLines/HomeMineSP1.dtl",
"HomeMineSP2": "res://Dialogic/TimeLines/HomeMineSP2.dtl",
"HomeSpeakPoint1": "res://Dialogic/TimeLines/HomeSpeakPoint1.dtl",
"SlimeEndDialog": "res://Dialogic/TimeLines/SlimeEndDialog.dtl"
}
glossary/default_case_sensitive=true
layout/style_list=["res://Resources/Assets/Slime-Sheet/VisualNovel.tres", "res://Dialogic/Styles/BubbleStyle.tres", "res://Dialogic/Styles/Style1.tres"]
layout/default_style="res://Dialogic/Styles/Style1.tres"
variables={
"BeginSlimeKilled": 0
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
choices/def_false_behaviour=1
text/autocolor_names=true
translation/enabled=false
translation/original_locale="zh_CN"
translation/file_mode=1
translation/translation_folder=""
translation/save_mode=0
translation/add_separator=false
glossary/glossary_files=["res://Dialogic/Characters/Glossary.tres"]

[dialogue_manager]

general/uses_dotnet=true

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="2da"

[editor_plugins]

enabled=PackedStringArray("res://addons/com.timothyqiu.animation-resetter/plugin.cfg", "res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://Dialogic/": "teal",
"res://Properties/": "gray",
"res://Resources/": "red",
"res://Scenes/": "yellow",
"res://Scripts/": "green"
}

[global_group]

savepoints=""
Telepositions=""
doors=""
enemies=""
maps=""
crates=""
movemarker=""
static_rope_point=""

